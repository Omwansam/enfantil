# Copy to .env and fill in. All settings are read by src/config/env.js.
PORT=5000
NODE_ENV=development
# PostgreSQL connection (database must exist; `npm run db:migrate` creates the tables).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/enfantil"
# Signs the login tokens for both apps: at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
STAFF_TOKEN_TTL=8h
FAMILY_TOKEN_TTL=30d
# Browser origins allowed to call the API (family app and clinician portal).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174
# true: any 6-digit SMS code except 000000 works (no SMS provider yet). Must be false in production.
OTP_DEMO=true
# Proxy hops in front of the API (e.g. 1 behind nginx), for correct client IPs in rate limits.
TRUST_PROXY=
TZ=Africa/Nairobi
